CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Bluetooth: Classic only (Palm OS 5 is BT 1.1)
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_SDP_COMMON_ENABLED=y

# PPP server + NAT from PPP link to Wi-Fi
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_SERVER_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
# VJ-compressed TCP headers bypass NAPT and get dropped (IDF warns about this for NAPT on PPP)
CONFIG_LWIP_PPP_VJ_HEADER_COMPRESSION=n

# debug logs available at runtime (esp_log_level_set)
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# lwIP counters for the stats log line
CONFIG_LWIP_STATS=y
